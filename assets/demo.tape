Output dist/demo.gif
Output dist/demo.mp4
#Output dist/demo.webm

Require ir

Set Theme "MaterialDark"
Set MarginFill "#00ADD8"
Set Margin 8
Set WindowBar Colorful
Set BorderRadius 12
Set Padding 20
Set Width 1200
Set Height 720
Set FontSize 34

Env TERM "xterm-256color"
Env COLORTERM "truecolor"

Source assets/main.tape
